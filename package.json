{
  "name": "kata-4d-toys-clone-codex-openai-gpt-5-5-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:file",
    "build:file": "esbuild src/main.ts --bundle --format=iife --global-name=ToyboxApp --platform=browser --target=es2022 --outfile=game.js --loader:.css=css",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "three": "^0.180.0",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  }
}
